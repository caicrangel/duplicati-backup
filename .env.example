# Copie este arquivo para .env e ajuste os valores antes de subir o stack:
#   cp .env.example .env

# Identificação do servidor (aparece na interface do Duplicati)
SERVER_HOSTNAME=srv-exemplo

# Usuário/grupo do host donos dos arquivos (verifique com: id)
PUID=1000
PGID=1000

# Fuso horário
TZ=America/Sao_Paulo

# Ponto de montagem do servidor de arquivos no HOST (NFS/CIFS/etc.)
# Será exposto dentro do Duplicati como /fileserver (somente leitura)
FILESERVER_MOUNT=/mnt/fileserver

# Senha da interface web do Duplicati
# Gere uma com: openssl rand -base64 12
DUPLICATI_WEB_PASSWORD=troque-esta-senha

# Chave de criptografia das configurações do Duplicati
# Gere uma com: openssl rand -base64 16
DUPLICATI_SETTINGS_KEY=troque-esta-chave
