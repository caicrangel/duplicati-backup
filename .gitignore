# Segredos locais
.env
scripts/check-mounts.env
scripts/telegram_config.env

# Logs dos scripts
scripts/log/*
!scripts/log/.gitkeep

# Dados de runtime dos containers (mantém apenas o .gitkeep de cada pasta)
duplicati/config/*
duplicati/backups/*
filebrowser/database/*
filebrowser/config/*
filebrowser/srv/*
!duplicati/config/.gitkeep
!duplicati/backups/.gitkeep
!filebrowser/database/.gitkeep
!filebrowser/config/.gitkeep
!filebrowser/srv/restore/
filebrowser/srv/restore/*
!filebrowser/srv/restore/.gitkeep
